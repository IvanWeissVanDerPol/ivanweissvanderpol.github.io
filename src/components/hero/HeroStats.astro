---
// Hero statistics display component
import { heroData } from '../../data/index.js';

export interface Props {
  stats?: {
    efficiency?: string;
    experience?: string;
    projectsCompleted?: string;
  };
  showLabels?: boolean;
}

// Ensure stats always have values (fallback if data loading fails)
const defaultStats = {
  efficiency: "40%",
  experience: "6+",
  projectsCompleted: "25+",
  teamSize: "8+"
};

const {
  stats = heroData?.stats || defaultStats,
  showLabels = true
} = Astro.props;
---

{stats && (
  <div class="value-props">
    {stats.efficiency && (
      <div class="value-prop">
        <span class="prop-metric">{stats.efficiency}</span>
        {showLabels && <span class="prop-label">Efficiency Increase</span>}
      </div>
    )}
    {stats.experience && (
      <div class="value-prop">
        <span class="prop-metric">{stats.experience}</span>
        {showLabels && <span class="prop-label">Years Experience</span>}
      </div>
    )}
    {stats.projectsCompleted && (
      <div class="value-prop">
        <span class="prop-metric">{stats.projectsCompleted}</span>
        {showLabels && <span class="prop-label">Projects Completed</span>}
      </div>
    )}
    {stats.teamSize && (
      <div class="value-prop">
        <span class="prop-metric">{stats.teamSize}</span>
        {showLabels && <span class="prop-label">Team Members Led</span>}
      </div>
    )}
  </div>
)}

<style>
  /* Value Propositions */
  .value-props {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    padding: 0;
    margin: 0;
  }

  .value-prop {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: var(--space-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    transition: all var(--transition-normal);
    opacity: 0;
    animation: fadeInScale 0.6s ease forwards;
    animation-delay: 1.2s;
  }

  .value-prop:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px var(--shadow-md);
  }

  .value-prop:nth-child(2) {
    animation-delay: 1.3s;
  }

  .value-prop:nth-child(3) {
    animation-delay: 1.4s;
  }

  .value-prop:nth-child(4) {
    animation-delay: 1.5s;
  }

  .prop-metric {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: var(--font-bold);
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-xs);
    line-height: 1;
  }

  .prop-label {
    font-size: var(--font-xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: var(--font-medium);
  }

  /* Animations */
  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .value-props {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .value-prop {
      padding: var(--space-md);
    }

    .prop-metric {
      font-size: 2rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .value-prop {
      animation: none;
      opacity: 1;
    }
  }
</style>