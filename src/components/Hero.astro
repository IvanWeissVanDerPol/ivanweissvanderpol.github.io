v---
// Modern Hero section - unified design with the rest of the site
import { heroData, themeConfig, socialLinks } from '../data/index.js';
import Button from './ui/Button.astro';

// Prepare description with university link
const description = `${heroData.rolePrefix} <strong>${heroData.role}</strong>${heroData.roleIntroduction} <a href="${heroData.university.url}" class="university-link">${heroData.university.name}</a>.`;
---

<article class="hero-section">
  <div class="hero-container">
    <!-- Background Elements -->
    <div class="hero-background">
      <div class="hero-mesh"></div>
      <div class="hero-particles"></div>
    </div>

    <!-- Main Hero Content -->
    <div class="hero-main">
      <div class="hero-content">
        <!-- Status Badge -->
        <div class="status-badge">
          <div class="status-dot"></div>
          <span>Available for projects</span>
        </div>

        <!-- Main Title -->
        <h1 class="hero-title">
          <span class="greeting">{heroData.greeting}</span>
          <span class="name gradient-text">{heroData.name}</span>
          <span class="role-text">{heroData.role}</span>
          <span class="subtitle-text">{heroData.subtitle}</span>
        </h1>

        <!-- Description -->
        <div class="hero-description">
          <p class="description-main">{heroData.fullDescription}</p>

          <!-- Key value propositions -->
          <div class="value-props">
            <div class="value-prop">
              <span class="prop-metric">{heroData.stats?.efficiency}</span>
              <span class="prop-label">Efficiency Increase</span>
            </div>
            <div class="value-prop">
              <span class="prop-metric">{heroData.stats?.experience}</span>
              <span class="prop-label">Years Experience</span>
            </div>
            <div class="value-prop">
              <span class="prop-metric">{heroData.stats?.projectsCompleted}</span>
              <span class="prop-label">Projects Completed</span>
            </div>
          </div>
          
          <!-- Social Links -->
          <div class="hero-social">
            <span class="social-intro">Connect with me</span>
            <div class="social-links">
              <!-- Copy Email Button -->
              <button id="copyEmailBtn" class="social-link-button email-copy-btn" aria-label="Copy email to clipboard">
                <i class="fas fa-copy"></i>
                <span class="link-text">weissvanderpol.ivan@gmail.com</span>
              </button>
              
              <!-- Social Media Links -->
              <div class="social-platforms">
                {socialLinks.primary.filter(link => link.icon !== 'fa-envelope').map(link => (
                  <a href={link.url} class="social-link-button" target="_blank" rel="noopener">
                    <i class={`fab ${link.icon}`}></i>
                    <span class="link-text">{link.name}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons - Professional CTAs -->
        <div class="hero-actions">
          <div class="primary-cta">
            <Button variant="primary" size="large" href="#projects" class="cta-primary">
              <i class="fas fa-rocket"></i>
              View My Projects
            </Button>
            <Button variant="secondary" size="large" href="/resume.pdf" class="cta-secondary" download>
              <i class="fas fa-download"></i>
              Download Resume
            </Button>
          </div>

          <div class="contact-cta">
            <button class="btn btn-outline btn-large contact-modal-trigger">
              <i class="fas fa-envelope"></i>
              Let's Work Together
            </button>
          </div>
        </div>
      </div>

      <!-- Professional Image -->
      <div class="hero-image">
        <div class="image-container">
          <img
            src={heroData.image.src}
            alt={heroData.image.alt}
            class="profile-image"
            loading="eager"
          />
          <div class="image-overlay">
            <div class="availability-indicator">
              <span class="indicator-dot"></span>
              <span class="indicator-text">Available for new projects</span>
            </div>
          </div>
        </div>

        <!-- Professional credentials -->
        <div class="credentials">
          <div class="credential-item">
            <i class="fas fa-graduation-cap"></i>
            <span>Computer Science Student at {heroData.university.name}</span>
          </div>
          <div class="credential-item">
            <i class="fas fa-map-marker-alt"></i>
            <span>{heroData.location}</span>
          </div>
          <div class="credential-item">
            <i class="fas fa-clock"></i>
            <div class="time-display" id="heroParaguayTime">
              <span class="time-stat">--:--</span>
              <span class="time-label">Local Time</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</article>

<style>
  @import '../styles/sections/hero.css';

  /* Enhanced Hero Styles */
  .hero-section {
    background: var(--gradient-dark);
    position: relative;
    overflow: hidden;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--gradient-mesh);
    opacity: 0.3;
    pointer-events: none;
  }

  .hero-title .subtitle-text {
    display: block;
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    color: var(--neutral-400);
    margin-top: var(--space-2);
    line-height: var(--leading-relaxed);
  }

  .value-props {
    display: flex;
    gap: var(--space-6);
    margin: var(--space-6) 0;
    flex-wrap: wrap;
  }

  .value-prop {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 120px;
  }

  .prop-metric {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .prop-label {
    font-size: var(--text-sm);
    color: var(--neutral-500);
    font-weight: var(--font-medium);
    margin-top: var(--space-1);
  }

  .hero-actions {
    margin-top: var(--space-8);
  }

  .primary-cta {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .contact-cta {
    display: flex;
    justify-content: center;
  }

  .hero-image {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .image-container {
    position: relative;
    width: 300px;
    height: 300px;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    border: 3px solid var(--glass-light);
    box-shadow: 0 20px 40px rgba(0, 212, 255, 0.1);
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .image-container:hover .profile-image {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    padding: var(--space-4);
  }

  .availability-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: white;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .indicator-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .credentials {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-align: center;
  }

  .credential-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--neutral-400);
    font-size: var(--text-sm);
  }

  .credential-item i {
    color: var(--accent-cyan);
    width: 16px;
  }

  .time-display {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .time-stat {
    font-weight: var(--font-semibold);
    color: var(--neutral-200);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  @media (max-width: 768px) {
    .value-props {
      justify-content: center;
      gap: var(--space-4);
    }

    .primary-cta {
      flex-direction: column;
    }

    .image-container {
      width: 250px;
      height: 250px;
    }

    .credentials {
      align-items: center;
    }
  }

  /* Enhanced Terminal Styles */
  .terminal-container {
    margin-top: var(--space-4);
  }
  
  .terminal-toggle {
    background: var(--bg-card);
    border: 2px solid var(--border-primary);
    border-radius: var(--radius-lg);
    color: var(--text-primary);
    padding: var(--space-3) var(--space-4);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: var(--transition-normal);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    justify-content: center;
  }
  
  .terminal-toggle:hover {
    background: var(--bg-card-hover);
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }
  
  .visual-card.windows-terminal {
    margin-top: var(--space-4);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-lg);
    overflow: hidden;
    opacity: 0;
    max-height: 0;
    transition: all var(--transition-slow);
  }
  
  .visual-card.windows-terminal.show {
    opacity: 1;
    max-height: 500px;
  }
  
  .card-header {
    background: var(--bg-quaternary);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-muted);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .window-controls {
    display: flex;
    gap: var(--space-2);
  }
  
  .control {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    color: transparent;
    transition: var(--transition-fast);
  }
  
  .control.minimize { background: #ffbd2e; }
  .control.maximize { background: #28ca42; }
  .control.close { background: #ff5f56; }
  
  .control:hover {
    color: var(--text-primary);
  }
  
  .card-title {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }
  
  .terminal-content {
    padding: var(--space-4);
    font-family: 'Fira Code', 'Cascadia Code', 'Monaco', monospace;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    background: var(--bg-primary);
  }
  
  .terminal-prompt {
    color: var(--color-success);
    margin-bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  
  .prompt-path {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }
  
  .prompt-command {
    color: var(--text-primary);
  }
  
  .code-block {
    position: relative;
  }
  
  .code-line {
    margin-bottom: var(--space-1);
    transition: all var(--transition-normal);
  }
  
  .code-line.typing {
    background: rgba(59, 130, 246, 0.1);
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
  }
  
  .indent { padding-left: var(--space-4); }
  .indent2 { padding-left: var(--space-8); }
  
  /* Enhanced Syntax Highlighting */
  .code-keyword {
    color: #ff79c6;
    font-weight: var(--font-weight-semibold);
  }
  
  .code-class {
    color: #8be9fd;
    font-weight: var(--font-weight-semibold);
  }
  
  .code-function {
    color: #50fa7b;
    font-weight: var(--font-weight-medium);
  }
  
  .code-string {
    color: #f1fa8c;
  }
  
  .code-property {
    color: #bd93f9;
  }
  
  .code-variable {
    color: #f8f8f2;
  }
  
  .code-boolean {
    color: #ff79c6;
    font-weight: var(--font-weight-medium);
  }
  
  .code-comment {
    color: #6272a4;
    font-style: italic;
  }
  
  .code-builtin {
    color: #8be9fd;
    font-weight: var(--font-weight-medium);
  }
  
  .terminal-cursor {
    display: inline-block;
    width: 10px;
    height: 18px;
    background: var(--color-primary);
    margin-left: var(--space-1);
    opacity: 0;
    border-radius: 2px;
  }
  
  .terminal-cursor.blink {
    animation: cursor-blink 1s infinite;
  }
  
  @keyframes cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  
  /* Responsive Terminal */
  @media (max-width: 768px) {
    .terminal-content {
      font-size: 12px;
      padding: var(--space-3);
    }
    
    .indent { padding-left: var(--space-2); }
    .indent2 { padding-left: var(--space-4); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const copyEmailBtn = document.getElementById('copyEmailBtn');
    const contactModalTrigger = document.querySelector('.contact-modal-trigger');
    
    // Copy email functionality
    if (copyEmailBtn) {
      copyEmailBtn.addEventListener('click', async function() {
        const email = 'weissvanderpol.ivan@gmail.com';
        
        try {
          await navigator.clipboard.writeText(email);
          
          // Visual feedback
          const icon = this.querySelector('i');
          const originalIcon = icon.className;
          const originalText = this.querySelector('.link-text').textContent;
          
          icon.className = 'fas fa-check';
          this.querySelector('.link-text').textContent = 'Email copied!';
          this.style.background = 'var(--color-success)';
          this.style.borderColor = 'var(--color-success)';
          this.style.color = 'white';
          
          setTimeout(() => {
            icon.className = originalIcon;
            this.querySelector('.link-text').textContent = originalText;
            this.style.background = '';
            this.style.borderColor = '';
            this.style.color = '';
          }, 2000);
        } catch (err) {
          // Fallback for older browsers
          const textArea = document.createElement('textarea');
          textArea.value = email;
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          document.body.removeChild(textArea);
          
          // Visual feedback
          const icon = this.querySelector('i');
          const originalIcon = icon.className;
          const originalText = this.querySelector('.link-text').textContent;
          
          icon.className = 'fas fa-check';
          this.querySelector('.link-text').textContent = 'Email copied!';
          
          setTimeout(() => {
            icon.className = originalIcon;
            this.querySelector('.link-text').textContent = originalText;
          }, 2000);
        }
      });
    }
    
    // Contact modal trigger
    if (contactModalTrigger && typeof window.openContactModal === 'function') {
      contactModalTrigger.addEventListener('click', function() {
        window.openContactModal();
      });
    }

    // Terminal toggle functionality
    const terminalToggle = document.getElementById('terminalToggle');
    const terminalContent = document.getElementById('terminal-content');
    
    if (terminalToggle && terminalContent) {
      terminalToggle.addEventListener('click', function() {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        const newState = !isExpanded;
        
        this.setAttribute('aria-expanded', newState.toString());
        terminalContent.setAttribute('aria-hidden', (!newState).toString());
        
        if (newState) {
          terminalContent.classList.add('show');
          this.querySelector('.toggle-text').textContent = 'Hide Code';
          this.querySelector('.toggle-icon').textContent = '📟';
          
          // Start typing animation when terminal opens
          setTimeout(() => startTypingAnimation(), 500);
        } else {
          terminalContent.classList.remove('show');
          this.querySelector('.toggle-text').textContent = 'Show Code';
          this.querySelector('.toggle-icon').textContent = '💻';
        }
      });
    }

    // Enhanced Terminal Typing Animation
    let typingAnimationRunning = false;
    
    function startTypingAnimation() {
      if (typingAnimationRunning) return;
      typingAnimationRunning = true;
      
      const codeLines = document.querySelectorAll('#terminal-code .code-line');
      const cursor = document.getElementById('terminal-cursor');
      
      // Hide all lines initially
      codeLines.forEach(line => {
        line.style.opacity = '0';
        line.style.transform = 'translateX(-10px)';
      });
      
      // Show cursor
      if (cursor) {
        cursor.style.opacity = '1';
        cursor.classList.add('blink');
      }
      
      // Animate lines appearing with typing effect
      codeLines.forEach((line, index) => {
        setTimeout(() => {
          line.style.transition = 'all 0.3s ease';
          line.style.opacity = '1';
          line.style.transform = 'translateX(0)';
          
          // Add typing sound effect (visual)
          line.classList.add('typing');
          setTimeout(() => line.classList.remove('typing'), 300);
          
        }, index * 200);
      });
    }

    // Hero Paraguay time display
    function updateHeroParaguayTime() {
      const heroTime = document.getElementById('heroParaguayTime');
      if (heroTime) {
        const timeDisplay = heroTime.querySelector('.time-stat');
        
        if (timeDisplay) {
          const now = new Date();
          
          // Paraguay timezone - America/Asuncion (simplified for hero display)
          const paraguayTime = new Intl.DateTimeFormat('en-US', {
            timeZone: 'America/Asuncion',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
          }).format(now);
          
          timeDisplay.textContent = paraguayTime;
        }
      }
    }

    // Update hero time immediately and then every minute (less frequent for hero)
    updateHeroParaguayTime();
    const heroTimeInterval = setInterval(updateHeroParaguayTime, 60000); // Update every minute

    // Store cleanup function
    window.heroTimeCleanup = () => {
      if (heroTimeInterval) {
        clearInterval(heroTimeInterval);
      }
    };
  });
</script>