---
// Simplified Work Experience Component - Clean, Professional Layout
export interface Props {
  company: string;
  position: string;
  duration: string;
  location: string;
  type: string;
  status: string;
  description: string;
  responsibilities: string[];
  technologies: string[];
  achievements: string[];
  companyInfo: {
    website?: string;
    industry: string;
    size: string;
    logo?: string;
  };
  'data-sal'?: string;
  'data-sal-delay'?: string | number;
  'data-sal-duration'?: string | number;
}

const {
  company,
  position,
  duration,
  location,
  type,
  status,
  description,
  responsibilities,
  technologies,
  achievements,
  companyInfo,
  ...props
} = Astro.props;

// Merge achievements and responsibilities into single "Key Achievements" list
const keyAchievements = [...achievements.slice(0, 3)];

// Clean up description by removing filler words
const cleanDescription = description
  .replace(/Successfully\s+/gi, '')
  .replace(/robust and innovative\s+/gi, '')
  .replace(/tailored for[^.]+unique operational needs/gi, '');

// Format technologies as simple comma-separated list
const techList = technologies.slice(0, 6).join(' • ');
---

<div class="work-card-simplified" {...props}>
  <!-- Header -->
  <div class="work-header">
    <div class="work-title-group">
      <h3 class="work-position">{position}</h3>
      <div class="work-meta">
        <span class="work-company">{company}</span>
        <span class="work-date">{duration}</span>
        <span class="work-location">{location} • {type}</span>
      </div>
    </div>
    {status === 'current' && (
      <span class="current-badge">Current</span>
    )}
  </div>

  <!-- Description -->
  <p class="work-summary">{cleanDescription}</p>

  <!-- Key Achievements (merged impact + responsibilities) -->
  <div class="work-achievements">
    <h4 class="section-heading">Key Achievements</h4>
    <ul class="achievements-list">
      {keyAchievements.map(achievement => (
        <li>{achievement}</li>
      ))}
    </ul>
  </div>

  <!-- Technologies -->
  <div class="work-tech">
    <span class="tech-list">{techList}</span>
  </div>
</div>

<style>
  /* Simplified Work Card - Clean, Professional Layout */
  .work-card-simplified {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(71, 85, 105, 0.4);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 1.5rem;
    transition: all 0.3s ease;
  }

  .work-card-simplified:hover {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(37, 99, 235, 0.6);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  /* Header Section */
  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .work-title-group {
    flex: 1;
  }

  .work-position {
    font-size: 1.375rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .work-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: #cbd5e1;
  }

  .work-company {
    color: #60a5fa;
    font-weight: 600;
  }

  .work-date {
    color: #94a3b8;
  }

  .work-location {
    color: #94a3b8;
  }

  .current-badge {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #ffffff;
    padding: 0.375rem 0.875rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Description */
  .work-summary {
    color: #e2e8f0;
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  /* Achievements Section */
  .work-achievements {
    margin-bottom: 1.5rem;
  }

  .section-heading {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 0.75rem 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .achievements-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .achievements-list li {
    color: #e2e8f0;
    font-size: 0.9375rem;
    line-height: 1.7;
    padding-left: 1.25rem;
    position: relative;
  }

  .achievements-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: #60a5fa;
    font-weight: 700;
  }

  /* Technologies */
  .work-tech {
    padding-top: 1rem;
    margin-top: 1rem;
    border-top: 1px solid rgba(71, 85, 105, 0.3);
  }

  .tech-list {
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .work-card-simplified {
      padding: 1.5rem;
    }

    .work-header {
      flex-direction: column;
    }

    .current-badge {
      align-self: flex-start;
    }

    .work-position {
      font-size: 1.25rem;
    }

    .work-meta {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
