---
// Projects section component - loads all content from data files
import { portfolioData, themeConfig } from '../data/index.js';

// Filter featured projects
const featuredProjects = portfolioData.projects.filter(project => project.featured);
const otherProjects = portfolioData.projects.filter(project => !project.featured);
---

<article id={portfolioData.sectionId} class={portfolioData.layout.wrapperClass}>
  <div 
    class={portfolioData.layout.containerClass}
    data-sal="fade"
    data-sal-duration="800"
  >
    <header class="major">
      <h2 data-sal="slide-up" data-sal-delay="100">{portfolioData.title}</h2>
      <p data-sal="slide-up" data-sal-delay="200">{portfolioData.subtitle}</p>
    </header>

    <!-- Featured Projects -->
    <section class="featured-projects">
      <h3
        class="section-subtitle"
        data-sal="slide-right"
        data-sal-delay="200"
      >
        Featured Projects
      </h3>

      <div class="projects-grid">
        {featuredProjects.map((project, index) => (
          <div class="project-wrapper">
            <div 
              class="project-card featured"
              data-sal="zoom-in" 
              data-sal-delay={300 + (index * 150)}
            >
              <div class="project-image">
                <img src={project.image} alt={project.title} />
                <div class="project-overlay">
                  <div class="project-links">
                    {project.liveUrl && (
                      <a href={project.liveUrl} class="button small" target="_blank" rel="noopener">
                        <i class="icon fas fa-external-link-alt"></i> Live Demo
                      </a>
                    )}
                    {project.githubUrl && (
                      <a href={project.githubUrl} class="button small" target="_blank" rel="noopener">
                        <i class="icon brands fa-github"></i> Code
                      </a>
                    )}
                  </div>
                </div>
              </div>
              
              <div class="project-content">
                <header>
                  <div class="header-top">
                    <h4>{project.title}</h4>
                    <div class="project-meta">
                      <span class="category">{project.category}</span>
                      {project.company && (
                        <span class="company">@ {project.company}</span>
                      )}
                      <span class={`status status-${project.status}`}>{project.status}</span>
                      {project.duration && (
                        <span class="duration">{project.duration}</span>
                      )}
                    </div>
                  </div>
                </header>

                <p class="project-description">{project.description}</p>

                <div class="project-details">
                  {/* Business Impact Section */}
                  {project.businessImpact && (
                    <div class="business-impact">
                      <h5><i class="fas fa-chart-bar"></i> Impact</h5>
                      <div class="impact-metrics">
                        {project.businessImpact.slice(0, 2).map(impact => (
                          <span class="metric-item">
                            <i class="fas fa-arrow-up"></i>
                            {impact}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}

                  <div class="highlights">
                    <h5><i class="fas fa-star"></i> Achievements</h5>
                    <ul>
                      {project.highlights.slice(0, 3).map(highlight => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="technologies">
                  {project.technologies.map(tech => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Other Projects -->
    {otherProjects.length > 0 && (
      <section class="other-projects" style="margin-top: 3em;">
        <h3 
          class="section-subtitle"
          data-sal="slide-right" 
          data-sal-delay="200"
        >
          Other Projects
        </h3>
        
        <div class="row gtr-uniform">
          {otherProjects.map((project, index) => (
            <div class="col-4 col-6-medium col-12-small">
              <div 
                class="project-card compact"
                data-sal="fade" 
                data-sal-delay={300 + (index * 100)}
              >
                <header>
                  <h5>{project.title}</h5>
                  <span class="category">{project.category}</span>
                </header>
                
                <p>{project.description}</p>
                
                <div class="technologies">
                  {project.technologies.slice(0, 3).map(tech => (
                    <span class="tech-tag small">{tech}</span>
                  ))}
                  {project.technologies.length > 3 && (
                    <span class="tech-tag small more">+{project.technologies.length - 3}</span>
                  )}
                </div>
                
                <div class="project-links">
                  {project.liveUrl && (
                    <a href={project.liveUrl} class="link-icon" target="_blank" rel="noopener">
                      <i class="icon fas fa-external-link-alt"></i>
                    </a>
                  )}
                  {project.githubUrl && (
                    <a href={project.githubUrl} class="link-icon" target="_blank" rel="noopener">
                      <i class="icon brands fa-github"></i>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Call to Action -->
    <section class="cta-section" style="margin-top: 3em;">
      <div 
        class="cta-content"
        data-sal="fade" 
        data-sal-delay="200"
      >
        <h3>{portfolioData.callToAction.title}</h3>
        <p>{portfolioData.callToAction.description}</p>
        <a href={portfolioData.callToAction.buttonLink} class="button large">
          {portfolioData.callToAction.buttonText}
        </a>
      </div>
    </section>
  </div>
</article>

<style>
  @import '../styles/sections/projects-dark.css';

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
    margin-top: var(--space-2xl);
  }

  .project-wrapper {
    width: 100%;
  }

  /* Enhanced Professional Project Styling */
  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .header-top h4 {
    margin: 0;
    flex: 1;
    color: #ffffff;
    font-size: 1.75rem;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    justify-content: flex-end;
  }

  .company {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    font-size: var(--font-xs);
  }

  .duration {
    color: #ffffff;
    font-size: 1rem;
    font-weight: var(--font-medium);
    white-space: nowrap;
  }

  .project-description {
    line-height: 1.8;
    margin-bottom: var(--space-md);
    color: #ffffff;
    font-size: 1.125rem;
  }

  .project-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .business-impact {
    background: linear-gradient(135deg,
      rgba(var(--color-primary-rgb), 0.08) 0%,
      rgba(var(--color-secondary-rgb), 0.08) 100%);
    border-left: 2px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .business-impact h5,
  .highlights h5 {
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: var(--font-bold);
    margin-bottom: var(--space-sm);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .business-impact h5 i,
  .highlights h5 i {
    font-size: var(--font-sm);
  }

  .impact-metrics {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .metric-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    color: #ffffff;
    font-size: 1rem;
    font-weight: var(--font-medium);
  }

  .metric-item i {
    color: var(--color-success);
    margin-top: 2px;
    flex-shrink: 0;
    font-size: 10px;
  }

  .highlights ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .highlights li {
    position: relative;
    padding-left: var(--space-md);
    margin-bottom: var(--space-xs);
    color: #ffffff;
    font-size: 1rem;
    line-height: 1.7;
  }

  .highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: bold;
  }

  /* Enhanced project cards */
  .featured-projects {
    margin-top: var(--space-2xl);
  }

  .project-card.featured {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.3s ease;
    position: relative;
    box-shadow: 0 2px 8px var(--shadow-sm);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .project-card.featured:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--shadow-md);
    border-color: var(--color-primary);
  }

  .project-content {
    padding: var(--space-lg);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
  }

  .tech-tag {
    background: transparent;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    padding: 4px var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: 10px;
    font-weight: var(--font-semibold);
    transition: all 0.2s ease;
    display: inline-block;
  }

  .tech-tag:hover {
    background: var(--color-primary);
    color: white;
  }

  .project-image {
    display: none;
  }

  @media (max-width: 1024px) {
    .project-details {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  @media (max-width: 768px) {
    .projects-grid {
      gap: var(--space-xl);
    }

    .header-top {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .project-meta {
      justify-content: flex-start;
    }

    .project-content {
      padding: var(--space-md);
    }

    .project-description {
      font-size: var(--font-xs);
    }

    .business-impact {
      padding: var(--space-sm);
    }

    .highlights li {
      padding-left: var(--space-sm);
      font-size: 10px;
    }
  }
</style>