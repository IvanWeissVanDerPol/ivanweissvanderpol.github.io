---
import { aboutData } from '../../data/index.js';

export interface Props {
  showScrollIndicator?: boolean;
}

const { showScrollIndicator = true } = Astro.props;
---

<section id="summary" class="content-section">
  <h2>Professional Summary</h2>
  <div class="summary-container">
    <div class="summary-content">
      <div class="summary-text">
        <p class="intro">{aboutData.summary.intro}</p>
        <p class="focus">{aboutData.summary.focus}</p>
        <p class="goals">{aboutData.summary.goals}</p>
      </div>

      <!-- Core Stats integrated into summary section -->
      <div class="core-stats">
        <h3>At a Glance</h3>
        <div class="stats-grid">
          {aboutData.metrics.map(metric => (
            <div class="stat-item">
              <div class="stat-number">{metric.number}</div>
              <div class="stat-label">{metric.label}</div>
              <div class="stat-description">{metric.description}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Key Highlights moved into summary for better grouping -->
    <div class="key-highlights">
      <h3>Key Areas of Expertise</h3>
      <div class="highlights-grid">
        {aboutData.highlights.slice(0, 4).map((highlight, index) => (
          <div class="highlight-item" data-index={index}>
            <div class="highlight-icon">
              {highlight.image ? (
                <div class="icon-wrapper">
                  <img src={highlight.image} alt={highlight.title} loading="lazy" />
                  <div class="icon-overlay"></div>
                </div>
              ) : (
                <i class={highlight.icon}></i>
              )}
            </div>
            <div class="highlight-content">
              <h4>{highlight.title}</h4>
              <p>{highlight.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  {showScrollIndicator && (
    <div class="scroll-indicator">
      <div class="scroll-text">Scroll to explore</div>
      <div class="scroll-arrow">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  )}
</section>

<style>
  .content-section {
    min-height: 100vh;
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid var(--border-primary);
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
  }

  .content-section:last-child {
    border-bottom: none;
  }

  .summary-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .summary-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
  }

  .summary-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .summary-text p {
    margin: 0;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .summary-text .intro {
    font-size: var(--font-lg);
    color: var(--text-primary);
    font-weight: var(--font-medium);
  }

  /* Core Stats */
  .core-stats {
    background: linear-gradient(135deg, var(--bg-secondary), transparent);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .core-stats h3 {
    margin-bottom: var(--space-lg);
    color: var(--color-primary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    font-size: var(--font-2xl);
    font-weight: var(--font-bold);
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .stat-label {
    font-size: var(--font-sm);
    color: var(--text-primary);
    font-weight: var(--font-medium);
  }

  .stat-description {
    font-size: var(--font-xs);
    color: var(--text-secondary);
    margin-top: var(--space-xs);
  }

  /* Key Highlights */
  .key-highlights {
    margin-top: var(--space-xl);
  }

  .key-highlights h3 {
    margin-bottom: var(--space-xl);
    color: var(--text-primary);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-xl);
  }

  .highlight-item {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--bg-secondary-alpha);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    transition: all var(--transition-normal);
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
    animation-delay: calc(var(--index) * 0.1s);
  }

  .highlight-item[data-index="0"] { --index: 0; }
  .highlight-item[data-index="1"] { --index: 1; }
  .highlight-item[data-index="2"] { --index: 2; }
  .highlight-item[data-index="3"] { --index: 3; }

  .highlight-item:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary-alpha);
    background: var(--bg-secondary);
  }

  .highlight-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-alpha), transparent);
    border-radius: var(--radius-md);
    font-size: 1.5rem;
    color: var(--color-primary);
  }

  .icon-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .icon-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .highlight-content h4 {
    margin: 0 0 var(--space-sm) 0;
    color: var(--text-primary);
    font-size: var(--font-md);
  }

  .highlight-content p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--font-sm);
    line-height: 1.6;
  }

  /* Scroll Indicator */
  .scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--space-3xl);
    opacity: 0.6;
    animation: bounce 2s infinite;
  }

  .scroll-text {
    font-size: var(--font-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
  }

  .scroll-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-arrow span {
    display: block;
    width: 20px;
    height: 20px;
    border-bottom: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);
    transform: rotate(45deg);
    margin: -8px;
    animation: scroll-arrow 2s infinite;
  }

  .scroll-arrow span:nth-child(2) {
    animation-delay: -0.2s;
  }

  .scroll-arrow span:nth-child(3) {
    animation-delay: -0.4s;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }

  @keyframes scroll-arrow {
    0% {
      opacity: 0;
      transform: rotate(45deg) translate(-10px, -10px);
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: rotate(45deg) translate(10px, 10px);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .summary-content {
      grid-template-columns: 1fr;
    }

    .highlights-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .content-section {
      padding: var(--space-xl) 0;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .highlight-item {
      padding: var(--space-md);
    }
  }
</style>