---
// Home page - comprehensive portfolio showcase with optimized flow
import Layout from '../layouts/Layout.astro';
// Use the new refactored Navigation components
import NavigationLayout from '../components/navigation/NavigationLayout.astro';
// Keep original for backward compatibility
// import Navigation from '../components/Navigation.astro';
// Use the new refactored Hero components
import HeroLayout from '../components/hero/HeroLayout.astro';
// Keep original for backward compatibility
// import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import SkillsCompact from '../components/SkillsCompact.astro';
import Projects from '../components/Projects.astro';
import Work from '../components/Work.astro';
import Contact from '../components/Contact.astro';
import { siteConfig } from '../data/index.js';
---

<Layout
  title={siteConfig.title}
  description={siteConfig.description}
>
  <NavigationLayout />
  <HeroLayout />
  <About />
  <SkillsCompact />
  <Projects />
  <Work />
  <Contact />

  <!-- Back to Top Button -->
  <button id="back-to-top" class="back-to-top" aria-label="Back to top">
    <i class="fas fa-arrow-up"></i>
  </button>
</Layout>

<style is:global>
  /* CRITICAL CONTRAST FIXES - Force readable text everywhere */

  body {
    background: #0f172a !important;
    color: #ffffff !important;
    font-size: 18px !important;
    line-height: 1.7 !important;
  }

  /* All text must be white or light for readability */
  p, span, div:not(.proficiency-fill):not(.skill-fill), li, a, label, td, th, small {
    color: #e2e8f0 !important;
  }

  h1, h2, h3, h4, h5, h6 {
    color: #ffffff !important;
    font-weight: 700 !important;
  }

  h1 { font-size: clamp(2.5rem, 6vw, 4rem) !important; }
  h2 { font-size: clamp(2rem, 4vw, 3rem) !important; }
  h3 { font-size: clamp(1.5rem, 3vw, 2.25rem) !important; }
  h4 { font-size: 1.75rem !important; }

  /* WORK EXPERIENCE - Maximum readability */
  .work-card {
    background: rgba(30, 41, 59, 0.95) !important;
    border: 2px solid rgba(71, 85, 105, 0.6) !important;
  }

  .work-position-title,
  .work-company-name,
  .work-card h3,
  .work-card h4 {
    color: #ffffff !important;
    font-size: 1.75rem !important;
  }

  .work-description {
    color: #f1f5f9 !important;
    font-size: 1.125rem !important;
    line-height: 1.8 !important;
    background: rgba(51, 65, 85, 0.7) !important;
  }

  .responsibility-item,
  .achievement-text {
    color: #f1f5f9 !important;
    font-size: 1.0625rem !important;
    line-height: 1.8 !important;
  }

  /* PROJECT CARDS - Maximum readability */
  .project-card {
    background: rgba(30, 41, 59, 0.95) !important;
    border: 2px solid rgba(71, 85, 105, 0.6) !important;
  }

  .project-card h4,
  .project-card h3 {
    color: #ffffff !important;
    font-size: 1.875rem !important;
  }

  .project-description {
    color: #f1f5f9 !important;
    font-size: 1.125rem !important;
    line-height: 1.8 !important;
  }

  .highlights li,
  .metric-item {
    color: #f1f5f9 !important;
    font-size: 1.0625rem !important;
  }

  /* SKILLS - Better contrast */
  .competency-card {
    background: rgba(30, 41, 59, 0.95) !important;
    border: 2px solid rgba(71, 85, 105, 0.6) !important;
  }

  .competency-name,
  .skill-name {
    color: #ffffff !important;
    font-size: 1.375rem !important;
  }

  .competency-description {
    color: #e2e8f0 !important;
    font-size: 1.0625rem !important;
  }

  /* BUTTONS - More prominent */
  .button,
  .btn,
  button {
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%) !important;
    color: #ffffff !important;
    padding: 1rem 2.5rem !important;
    font-size: 1.125rem !important;
    font-weight: 600 !important;
    border-radius: 12px !important;
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.4) !important;
  }

  .button:hover,
  .btn:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0 12px 32px rgba(37, 99, 235, 0.5) !important;
  }

  /* SPACING - Consistent throughout */
  section,
  article {
    padding: 6rem 0 !important;
  }

  .projects-grid,
  .competencies-grid {
    gap: 2rem !important;
  }

  /* TAGS - Better visibility */
  .tech-tag,
  .category,
  .badge {
    background: rgba(37, 99, 235, 0.25) !important;
    border: 1px solid rgba(37, 99, 235, 0.6) !important;
    color: #ffffff !important;
    padding: 0.5rem 1rem !important;
    font-size: 0.9375rem !important;
    font-weight: 600 !important;
  }

  .tech-tag:hover {
    background: #2563eb !important;
    transform: translateY(-2px) !important;
  }

  /* LINKS - Visible */
  a {
    color: #60a5fa !important;
  }

  a:hover {
    color: #93c5fd !important;
  }

  /* CARDS - Glassmorphism */
  .card,
  .project-card,
  .work-card,
  .competency-card {
    backdrop-filter: blur(20px) !important;
  }

  .card:hover,
  .project-card:hover,
  .work-card:hover,
  .competency-card:hover {
    transform: translateY(-8px) !important;
    box-shadow: 0 20px 50px rgba(37, 99, 235, 0.3) !important;
    border-color: rgba(37, 99, 235, 0.6) !important;
  }

  /* Meta items - Better contrast */
  .work-meta-item,
  .project-meta span {
    color: #f1f5f9 !important;
    background: rgba(51, 65, 85, 0.8) !important;
    font-size: 0.9375rem !important;
  }

  /* Back to Top Button */
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    color: #ffffff;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.4);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:hover {
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 12px 32px rgba(37, 99, 235, 0.5);
  }

  .back-to-top:active {
    transform: translateY(-2px) scale(1.05);
  }

  @media (max-width: 768px) {
    .back-to-top {
      bottom: 1rem;
      right: 1rem;
      width: 48px;
      height: 48px;
    }
  }
</style>

<script>
  // Back to Top Button
  document.addEventListener('DOMContentLoaded', () => {
    const backToTopButton = document.getElementById('back-to-top');

    if (backToTopButton) {
      // Show/hide button based on scroll position
      const handleScroll = () => {
        if (window.scrollY > 500) {
          backToTopButton.classList.add('visible');
        } else {
          backToTopButton.classList.remove('visible');
        }
      };

      // Scroll to top on click
      backToTopButton.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });

      // Listen for scroll events
      window.addEventListener('scroll', handleScroll);

      // Initial check
      handleScroll();
    }
  });
</script>
