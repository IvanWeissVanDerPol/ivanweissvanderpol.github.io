---
// Compact Skills section - focused on core competencies
import { skillsData } from '../data/index.js';
import SectionHeader from './ui/SectionHeader.astro';

// Extract core competencies from the extensive skills data
const coreCompetencies = [
  {
    name: "Technical Leadership",
    level: 95,
    icon: "fas fa-users-cog",
    description: "Leading cross-functional teams and driving technical strategy",
    technologies: ["Team Management", "Project Planning", "Technical Architecture"]
  },
  {
    name: "Python Development",
    level: 98,
    icon: "fab fa-python",
    description: "Expert-level Python development across multiple domains",
    technologies: ["Python", "Django", "FastAPI", "Data Science"]
  },
  {
    name: "Data Engineering",
    level: 90,
    icon: "fas fa-database",
    description: "Building scalable data pipelines and processing systems",
    technologies: ["Apache Spark", "ETL Pipelines", "Big Data", "Cloud Platforms"]
  },
  {
    name: "Quality Assurance",
    level: 95,
    icon: "fas fa-shield-alt",
    description: "Comprehensive test automation and quality engineering",
    technologies: ["Test Automation", "CI/CD", "API Testing", "Performance Testing"]
  }
];

const technicalSkills = [
  { name: "Python", level: 98 },
  { name: "Java", level: 85 },
  { name: "JavaScript", level: 75 },
  { name: "Apache Spark", level: 88 },
  { name: "Power Platform", level: 85 },
  { name: "Git", level: 90 },
  { name: "Jenkins", level: 82 },
  { name: "Databricks", level: 82 }
];
---

<article id="skills" class="skills-section">
  <div class="container">
    <SectionHeader
      title="Core Competencies"
      subtitle="Delivering measurable impact through technical expertise and leadership"
    />

    <!-- Core Competencies Grid -->
    <div class="competencies-grid">
      {coreCompetencies.map((competency, index) => (
        <div class="competency-card" data-sal="fade-up" data-sal-delay={100 + (index * 150)}>
          <div class="competency-header">
            <div class="competency-icon">
              <i class={competency.icon}></i>
            </div>
            <div class="competency-info">
              <div class="name-proficiency">
                <h3 class="competency-name">{competency.name}</h3>
                <span class="proficiency-level">{competency.level}% Proficiency</span>
              </div>
              <div class="proficiency-bar">
                <div class="proficiency-fill" style={`width: ${competency.level}%`}></div>
              </div>
            </div>
          </div>
          <p class="competency-description">{competency.description}</p>
          <div class="technology-tags">
            {competency.technologies.map(tech => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Technical Skills Overview -->
    <div class="technical-overview">
      <h3 class="section-subtitle">Technical Skills Overview</h3>
      <div class="skills-compact-grid">
        {technicalSkills.map((skill, index) => (
          <div class="skill-compact" data-sal="slide-up" data-sal-delay={200 + (index * 50)}>
            <span class="skill-name">{skill.name}</span>
            <div class="skill-level-bar">
              <div class="skill-fill" style={`width: ${skill.level}%`}></div>
            </div>
            <span class="skill-percentage">{skill.level}%</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Professional Achievements -->
    <div class="achievements-summary">
      <h3 class="section-subtitle">Key Achievements</h3>
      <div class="achievements-grid">
        <div class="achievement-item" data-sal="zoom-in" data-sal-delay="300">
          <div class="achievement-number">40%</div>
          <div class="achievement-label">Efficiency Improvement</div>
        </div>
        <div class="achievement-item" data-sal="zoom-in" data-sal-delay="400">
          <div class="achievement-number">25+</div>
          <div class="achievement-label">Projects Delivered</div>
        </div>
        <div class="achievement-item" data-sal="zoom-in" data-sal-delay="500">
          <div class="achievement-number">100%</div>
          <div class="achievement-label">Quality Standards</div>
        </div>
        <div class="achievement-item" data-sal="zoom-in" data-sal-delay="600">
          <div class="achievement-number">6+</div>
          <div class="achievement-label">Years Experience</div>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .skills-section {
    padding: var(--section-padding-lg) 0;
    background: linear-gradient(180deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    position: relative;
    overflow: hidden;
  }

  .skills-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(37, 99, 235, 0.15) 0%, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(124, 58, 237, 0.15) 0%, transparent 40%),
      radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.1) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  /* Core Competencies Grid */
  .competencies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .competency-card {
    background: rgba(30, 41, 59, 0.5);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(71, 85, 105, 0.3);
    border-radius: 16px;
    padding: var(--space-6);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3),
                0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .competency-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--brand-primary), var(--brand-accent));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .competency-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 2px;
    background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .competency-card:hover {
    transform: translateY(-8px);
    background: rgba(30, 41, 59, 0.7);
    border-color: rgba(37, 99, 235, 0.6);
    box-shadow: 0 20px 40px rgba(37, 99, 235, 0.3),
                0 10px 20px rgba(124, 58, 237, 0.2);
  }

  .competency-card:hover::before,
  .competency-card:hover::after {
    opacity: 1;
  }

  .competency-header {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .competency-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 24px;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    transition: transform 0.3s ease;
  }

  .competency-card:hover .competency-icon {
    transform: scale(1.1) rotate(5deg);
  }

  .competency-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .name-proficiency {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .competency-name {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: #f1f5f9;
    margin: 0;
    line-height: 1.3;
  }

  .proficiency-level {
    font-size: 11px;
    font-weight: var(--font-semibold);
    color: var(--brand-primary);
    background: rgba(37, 99, 235, 0.08);
    padding: 4px 10px;
    border-radius: 12px;
    white-space: nowrap;
    letter-spacing: 0.3px;
  }

  .proficiency-bar {
    width: 100%;
    height: 6px;
    background: rgba(37, 99, 235, 0.08);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .proficiency-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--brand-primary), var(--brand-accent));
    border-radius: 8px;
    transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .proficiency-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .competency-description {
    color: #ffffff;
    line-height: 1.6;
    margin-bottom: var(--space-3);
    font-size: 1rem;
  }

  .technology-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-tag {
    padding: 6px 14px;
    background: rgba(37, 99, 235, 0.05);
    border: 1px solid rgba(37, 99, 235, 0.15);
    border-radius: 8px;
    font-size: 12px;
    font-weight: var(--font-medium);
    color: var(--brand-primary);
    transition: all 0.3s ease;
    cursor: default;
  }

  .tech-tag:hover {
    background: var(--brand-primary);
    color: white;
    border-color: var(--brand-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(37, 99, 235, 0.2);
  }

  /* Technical Skills Overview */
  .technical-overview {
    margin-bottom: var(--space-16);
  }

  .section-subtitle {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: #f1f5f9;
    text-align: center;
    margin-bottom: var(--space-8);
    position: relative;
    display: inline-block;
    left: 50%;
    transform: translateX(-50%);
  }

  .section-subtitle::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, var(--brand-primary), var(--brand-accent));
    border-radius: 2px;
  }

  .skills-compact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  .skill-compact {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: rgba(30, 41, 59, 0.4);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 12px;
    transition: all 0.3s ease;
    backdrop-filter: blur(8px);
  }

  .skill-compact:hover {
    background: rgba(30, 41, 59, 0.6);
    border-color: var(--brand-primary);
    transform: translateX(4px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .skill-name {
    font-weight: var(--font-semibold);
    color: #ffffff;
    min-width: 140px;
    font-size: 1rem;
  }

  .skill-level-bar {
    flex: 1;
    height: 6px;
    background: rgba(37, 99, 235, 0.08);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .skill-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--brand-primary), var(--brand-accent));
    border-radius: 8px;
    transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .skill-percentage {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--brand-primary);
    min-width: 45px;
    text-align: right;
  }

  /* Achievements Section */
  .achievements-summary {
    text-align: center;
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .achievement-item {
    padding: var(--space-8) var(--space-4);
    background: rgba(30, 41, 59, 0.5);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(71, 85, 105, 0.3);
    border-radius: 16px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .achievement-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100%;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(124, 58, 237, 0.1));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .achievement-item:hover {
    transform: translateY(-8px) scale(1.02);
    background: rgba(30, 41, 59, 0.7);
    box-shadow: 0 16px 32px rgba(37, 99, 235, 0.3);
    border-color: var(--brand-primary);
  }

  .achievement-item:hover::before {
    opacity: 1;
  }

  .achievement-number {
    font-size: var(--text-4xl);
    font-weight: var(--font-black);
    background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: var(--space-3);
    position: relative;
  }

  .achievement-label {
    font-size: 1rem;
    color: #ffffff;
    font-weight: var(--font-medium);
    line-height: 1.5;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .competencies-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .skills-compact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .achievements-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }

    .skill-compact {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
    }

    .skill-name {
      min-width: auto;
      text-align: center;
    }

    .skill-level-bar {
      width: 100%;
    }

    .skill-percentage {
      text-align: center;
    }

    .competency-card {
      padding: var(--space-5);
    }

    .competency-icon {
      width: 48px;
      height: 48px;
      font-size: 20px;
    }

    .achievement-number {
      font-size: var(--text-3xl);
    }
  }

  @media (max-width: 480px) {
    .achievements-grid {
      grid-template-columns: 1fr;
    }
  }
</style>