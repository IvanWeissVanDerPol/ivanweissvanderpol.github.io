---
// Modern Contact & Footer section - professional and branded
import { contactData, socialLinks } from '../data/index.js';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
---

<article id={contactData.sectionId} class="contact-section">
  <div class="contact-container">
    <!-- Background Elements -->
    <div class="contact-background">
      <div class="contact-pattern"></div>
      <div class="contact-gradient"></div>
    </div>

    <!-- Contact Content -->
    <div class="contact-content">
      <!-- Contact Header -->
      <div class="contact-header">
        <h2 class="contact-title">Let's Work Together</h2>
        <p class="contact-subtitle">
          Ready to bring your project to life? I'm available for freelance work and exciting opportunities.
        </p>
      </div>

      <!-- Contact Cards -->
      <div class="contact-cards">
        <!-- Email Card -->
        <Card variant="feature" class="contact-card">
          <div class="contact-card-icon">
            <i class="fas fa-envelope"></i>
          </div>
          <div class="contact-card-content">
            <h3>Send me an email</h3>
            <p>I typically respond within 24 hours</p>
            <a href={`mailto:${contactData.email}`} class="contact-link-email">
              {contactData.email}
            </a>
          </div>
        </Card>

        <!-- Calendar Card -->
        <Card variant="feature" class="contact-card">
          <div class="contact-card-icon">
            <i class="fas fa-calendar-alt"></i>
          </div>
          <div class="contact-card-content">
            <h3>Schedule a call</h3>
            <p>Let's discuss your project in detail</p>
            <button class="contact-link-btn contact-modal-trigger">
              Book a meeting
            </button>
          </div>
        </Card>

        <!-- Phone Card -->
        <Card variant="feature" class="contact-card">
          <div class="contact-card-icon">
            <i class="fas fa-phone-alt"></i>
          </div>
          <div class="contact-card-content">
            <h3>Give me a call</h3>
            <p>Available for phone consultations</p>
            <a href={`tel:${contactData.phone}`} class="contact-link-email">
              {contactData.phone}
            </a>
          </div>
        </Card>
      </div>

      <!-- Call to Action -->
      <div class="contact-cta">
        <h3>Ready to get started?</h3>
        <p>Drop me a line and let's create something amazing together.</p>
        <div class="cta-buttons">
          <button class="btn btn-primary btn-large contact-modal-trigger">
            <span class="btn-icon">✉️</span>
            Send Message
          </button>
          <button class="btn btn-secondary btn-large contact-modal-trigger">
            <span class="btn-icon">💼</span>
            Discuss Project
          </button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-content">
        <!-- Compact Footer Grid -->
        <div class="footer-grid">
          <div class="footer-brand">
            <h3 class="brand-name gradient-text">Ivan weiss van der pol</h3>
            <p class="brand-tagline">Building digital experiences with modern technology</p>
          </div>

          <div class="footer-section">
            <h4>Navigation</h4>
            <ul>
              <li><a href="#about">About</a></li>
              <li><a href="#skills">Skills</a></li>
              <li><a href="#projects">Projects</a></li>
              <li><a href="#work">Experience</a></li>
            </ul>
          </div>

          <div class="footer-section">
            <h4>Technologies</h4>
            <ul>
              <li><a href="#skills">JavaScript</a></li>
              <li><a href="#skills">Python</a></li>
              <li><a href="#skills">React</a></li>
              <li><a href="#skills">Astro</a></li>
            </ul>
          </div>

          <div class="footer-section">
            <h4>Connect</h4>
            <div class="footer-social">
              {socialLinks.all.map(link => (
                <a href={link.url} class={`footer-social-link icon brands ${link.icon}`} target="_blank" rel="noopener">
                  <span class="sr-only">{link.label}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Compact Footer Bottom -->
        <div class="footer-bottom">
          <div class="footer-info">
            <p>&copy; {new Date().getFullYear()} Ivan weiss van der pol. All rights reserved.</p>
            <p>Built with <span class="heart">❤️</span> using Astro and modern web technologies.</p>
          </div>

          <div class="footer-status">
            <span class="status-dot"></span>
            Available for work
          </div>
        </div>
      </div>
    </footer>
  </div>
</article>

<style>
  @import '../styles/sections/contact.css';

  /* Enhanced Contact Section Styling */
  .contact-section {
    padding: var(--section-padding) 0;
    background: linear-gradient(135deg, var(--primary-900), var(--primary-800));
    position: relative;
    overflow: hidden;
  }

  .contact-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--gradient-mesh);
    opacity: 0.2;
    pointer-events: none;
  }

  .contact-container {
    position: relative;
    z-index: 1;
  }

  .contact-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .contact-title {
    font-size: var(--text-5xl);
    font-weight: var(--font-black);
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-4);
  }

  .contact-subtitle {
    font-size: var(--text-lg);
    color: var(--neutral-300);
    max-width: 600px;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
  }

  .contact-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .contact-card {
    background: linear-gradient(135deg, var(--glass-dark), var(--glass-medium)) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-light) !important;
    box-shadow: var(--shadow-lg);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--shadow-2xl), var(--shadow-glow);
    border-color: var(--accent-cyan) !important;
  }

  .contact-card-icon {
    width: 60px;
    height: 60px;
    background: var(--gradient-accent);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    font-size: var(--text-2xl);
    color: white;
    box-shadow: var(--shadow-glow);
  }

  .contact-card-content h3 {
    color: var(--neutral-100);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-2);
  }

  .contact-card-content p {
    color: var(--neutral-400);
    margin-bottom: var(--space-4);
  }

  .contact-link-btn {
    background: var(--glass-white);
    border: 1px solid var(--glass-light);
    color: var(--accent-cyan);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-lg);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-link-btn:hover {
    background: var(--accent-cyan);
    color: var(--primary-900);
    transform: scale(1.05);
    box-shadow: var(--shadow-glow);
  }

  .contact-link-email {
    display: inline-block;
    background: rgba(37, 99, 235, 0.1);
    border: 2px solid var(--brand-primary);
    color: var(--brand-primary);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-lg);
    font-weight: var(--font-semibold);
    font-size: 1.125rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-link-email:hover {
    background: var(--brand-primary);
    color: #ffffff;
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
  }

  /* Social Links Enhanced */
  .social-links-container {
    text-align: center;
    padding: var(--space-8) 0;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .social-link {
    width: 50px;
    height: 50px;
    background: var(--glass-white);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-light);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--neutral-300);
    font-size: var(--text-xl);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-link:hover {
    background: var(--gradient-accent);
    color: white;
    transform: translateY(-6px) rotate(5deg);
    box-shadow: var(--shadow-2xl), var(--shadow-glow);
    border-color: transparent;
  }

  /* Footer Enhanced */
  .footer-section {
    padding: var(--space-12) 0 var(--space-8);
    background: var(--primary-900);
    border-top: 1px solid var(--glass-light);
    text-align: center;
  }

  .footer-copyright {
    color: var(--neutral-500);
    font-size: var(--text-sm);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const contactModalTriggers = document.querySelectorAll('.contact-modal-trigger');
    
    contactModalTriggers.forEach(trigger => {
      trigger.addEventListener('click', function() {
        if (typeof window.openContactModal === 'function') {
          window.openContactModal();
        }
      });
    });
  });
</script>